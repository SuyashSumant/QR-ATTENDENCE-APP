                        <TextField layoutX="114.0" layoutY="34.0" promptText="Enter the Name" />
                        <TextField layoutX="114.0" layoutY="88.0" promptText="Enter the ID" />
                        <TextField layoutX="114.0" layoutY="141.0" promptText="Enter the dept" />
