            </AnchorPane>
         </left>
         <center>
            <AnchorPane prefHeight="361.0" prefWidth="278.0" style="-fx-border-color: #000000;" BorderPane.alignment="CENTER">
               <children>
                  <Label fx:id="dateLabel" layoutX="237.0" layoutY="22.0" prefHeight="34.0" prefWidth="74.0" text="08/03/2025 " textOverrun="CLIP" />
                  <Label fx:id="timeLabel" layoutX="14.0" layoutY="20.0" prefHeight="34.0" prefWidth="98.0" text="Time: 04:11 PM" textOverrun="CLIP" />
