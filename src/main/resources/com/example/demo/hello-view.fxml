                  <Button fx:id="AdddataButton" layoutX="20.0" layoutY="105.0" mnemonicParsing="false" onAction="#gotoAddData" prefHeight="38.0" prefWidth="172.0" styleClass="f" text="ADD DATA">
                     <font>
                        <Font name="Calibri" size="14.0" />
                     </font>
                  </Button>
                  <Line endX="69.0" endY="-1.52587890625E-5" layoutX="121.0" layoutY="80.0" startX="-100.0" stroke="WHITE" />
                  <Button layoutX="20.0" layoutY="161.0" mnemonicParsing="false" onAction="#gotoDelData" prefHeight="38.0" prefWidth="172.0" style="-fx-background-color: lightgray;" styleClass="f" text="DELETE DATA">
                     <font>
                        <Font name="Calibri Bold Italic" size="15.0" />
                     </font>
                  </Button>
                  <Button layoutX="20.0" layoutY="221.0" mnemonicParsing="false" prefHeight="38.0" prefWidth="172.0" styleClass="f" text="ACCESS DATA">
